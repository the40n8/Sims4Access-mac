{
	"name": "simsight-companion-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm i18n && vite dev",
		"build": "pnpm i18n && vite build",
		"generate": "buf generate ../proto",
		"check": "pnpm i18n && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"lint": "eslint --max-warnings 0 .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "pnpm check && pnpm lint && pnpm format:check && pnpm build",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations --silent"
	},
	"dependencies": {
		"@bufbuild/protobuf": "2.16.0",
		"@connectrpc/connect": "2.2.0",
		"@connectrpc/connect-web": "2.2.0",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0"
	},
	"devDependencies": {
		"@bufbuild/protoc-gen-es": "2.16.0",
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "2.28.0",
		"@inlang/plugin-message-format": "4.5.3",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.0",
		"globals": "17.14.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5"
	}
}
